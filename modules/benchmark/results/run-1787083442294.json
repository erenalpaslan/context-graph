                {
                    "id": "excalidraw-q2-f3",
                    "statement": "fixBindingsAfterDeletion also calls BindableElement.unbindAffected(elements, element, mutateElement) for each deleted element, to null out the binding pointer of any surviving element that had been bound to it.",
                    "evidence": "packages/excalidraw/element/binding.ts:1527"
                },
                {
                    "id": "excalidraw-q2-f4",
                    "statement": "BoundElement.unbindAffected visits the deleted bound element's bindable elements and, for each one whose boundElements array still references the deleted element's id, calls updateElementWith to rewrite that array with the deleted element's id filtered out.",
                    "evidence": "packages/excalidraw/element/binding.ts:1983"
                },
                {
                    "id": "excalidraw-q2-f5",
                    "statement": "BindableElement.unbindAffected visits the deleted bindable element's boundElements and, for each surviving element bound back to it, calls updateElementWith to null out that element's binding property (e.g. containerId, startBinding, or endBinding) so it no longer points at the deleted element.",
                    "evidence": "packages/excalidraw/element/binding.ts:2100"
                }
            ]
        },
