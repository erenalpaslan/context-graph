                {
                    "id": "excalidraw-q3-f3",
                    "statement": "The internal static-scene render routine draws individual elements by calling renderElement for each one (one of several such call sites in the function).",
                    "evidence": "packages/excalidraw/renderer/staticScene.ts:314"
                },
                {
                    "id": "excalidraw-q3-f4",
                    "statement": "renderElement (in renderer/renderElement.ts) calls ShapeCache.generateElementShape(element, renderConfig) to obtain the roughjs Drawable shape for the element before drawing it.",
                    "evidence": "packages/excalidraw/renderer/renderElement.ts:811"
                },
                {
