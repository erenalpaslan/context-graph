# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# Kotlin compiler build artifacts (e.g. .kotlin/sessions)
.kotlin/

# JVM
*.class
*.jar
*.war
*.ear
*.log

# IDE
.idea/
*.iml
*.ipr
*.iws
.vscode/

# ContextGraph runtime — graph.db is the committed baseline, written only by CI;
# graph.local.db is the gitignored developer/watcher overlay. See GraphDb.kt.
# Leading **/ matches nested .contextgraph/ dirs too (test fixtures, nested
# projects), not just the repo root — a plain ".contextgraph/*" has a slash in
# the middle, which git anchors to the .gitignore's own directory only, so
# nested dirs would otherwise fall through this rule entirely and rely on the
# *.db catch-all alone (which doesn't cover e.g. a nested config.json).
**/.contextgraph/*
*.db
*.db-shm
*.db-wal
!.contextgraph/graph.db

# Secrets
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
secrets/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Kotlin
*.kotlin_module

# Agent team workspace
agent-team/

# Benchmark corpus (modules/benchmark): pinned OSS repo clones and their two
# working copies (WITH/WITHOUT ContextGraph indexing, AC-1a). Reproducible
# from pinned tag/SHA in the result JSON; never checked in.
# Local developer secrets (benchmark API keys). Read by config/Secrets.kt as the
# fallback when the environment variable is unset. Never commit this — see
# local.properties.example for the expected keys.
local.properties

# Unanchored on purpose. prepare-corpus now resolves --corpus-root against the
# repo root (see RepoRoot.kt), so the corpus lands here and nowhere else — but a
# relative default once materialised a second 1.1 GB corpus under
# modules/benchmark/ when launched from Gradle's JavaExec working dir. This
# pattern is the backstop: whatever launches it, a corpus never gets committed.
**/.benchmark-corpus/

# LiteLLM proxy the benchmark installs and runs for its own judge (task 17,
# modules/benchmark/.../proxy/LiteLlmProxyManager.kt): a gitignored venv, the
# generated config.yaml (env-var indirection only, never a literal key), and
# the proxy's own log, all under <repo-root>/.benchmark-litellm/. Unanchored
# for the same reason as .benchmark-corpus above.
**/.benchmark-litellm/

# Repo-local install of third-party graph tools used as benchmark positive controls.
# Kept inside the repo so nothing is written to the developer machine globally.
.benchmark-tools/
